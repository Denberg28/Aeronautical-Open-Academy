# Populate only on the private server; never commit credentials or real learner data.
HOST=127.0.0.1
PORT=8787
ACADEMY_DATA_DIR=./data
NODE_ENV=development
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Links mode stores only material URLs; no Google service credential is required.
# Use drive for optional private PDF storage; local is development-only.
MATERIAL_STORAGE=links
DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
